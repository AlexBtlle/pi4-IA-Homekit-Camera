[Unit]
Description=mediamtx — RTSP server for Pi camera
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
# Camera and GPU access
SupplementaryGroups=video
ExecStart=/usr/local/bin/mediamtx /opt/pi4cam/mediamtx.yml
WorkingDirectory=/opt/pi4cam
Restart=on-failure
RestartSec=3
# Allow time for camera hardware to be ready after boot
TimeoutStartSec=20

[Install]
WantedBy=multi-user.target
