[Unit]
Description=mediamtx — RTSP server for Pi camera
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
ExecStart=/usr/local/bin/mediamtx /opt/pi4cam/mediamtx.yml
WorkingDirectory=/opt/pi4cam
Restart=on-failure
RestartSec=3
TimeoutStartSec=20

[Install]
WantedBy=multi-user.target
