[Unit]
Description=pi4tohomekit - HomeKit camera bridge with AI presence detection
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=/opt/pi4tohomekit
ExecStart=/opt/pi4tohomekit/venv/bin/python -m src.main
Restart=on-failure
RestartSec=5
# Grant camera and GPU access
SupplementaryGroups=video
# Camera initialisation can take up to 10 s on Pi 4
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
